{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xiiitore/authoritylab/blob/main/docs/capability-registry.schema.json",
  "title": "AuthorityLab Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_schema_version",
    "generated_on",
    "source",
    "status",
    "tool_count",
    "provider_counts",
    "classification_policy",
    "tools"
  ],
  "properties": {
    "registry_schema_version": {
      "const": "1.0.0"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "INVENTORY_ONLY_NOT_EXECUTION_VERIFIED"
    },
    "tool_count": {
      "type": "integer",
      "minimum": 0
    },
    "provider_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "classification_policy": {
      "type": "object",
      "required": [
        "preliminary_effect_class",
        "execution_verified",
        "no_implicit_authority"
      ],
      "additionalProperties": false,
      "properties": {
        "preliminary_effect_class": {
          "type": "string"
        },
        "execution_verified": {
          "type": "string"
        },
        "no_implicit_authority": {
          "type": "string"
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "provider",
          "description",
          "description_truncated",
          "preliminary_effect_class",
          "execution_verified",
          "notes"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "description_truncated": {
            "type": "boolean"
          },
          "preliminary_effect_class": {
            "enum": [
              "POTENTIAL_SIDE_EFFECT",
              "READ_OR_LOOKUP_BY_DESCRIPTION",
              "UNKNOWN_REQUIRES_REVIEW"
            ]
          },
          "execution_verified": {
            "const": false
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
